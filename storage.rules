rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Raw uploads: owner-only write, validated type/size. Never publicly readable (may contain EXIF GPS).
    match /uploads/{uid}/{reportId}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow read: if request.auth != null && (request.auth.uid == uid
        || request.auth.token.role in ['super_admin','moderator']);
    }
    // Sanitized copies (EXIF stripped by Cloud Function) – written only by Admin SDK.
    match /public/{reportId}/{file} { allow read: if true; allow write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
