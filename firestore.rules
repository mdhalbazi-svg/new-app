rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : ''; }
    function isStaff() { return role() in ['super_admin','moderator','support']; }
    function isMod() { return role() in ['super_admin','moderator']; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // All report/child/sighting/match/moderation writes go through Cloud Functions (Admin SDK).
    match /reports/{id} {
      allow read: if resource.data.status in ['published','possible_match','found','reunited']
                  || isOwner(resource.data.ownerId) || isStaff();
      allow write: if false;
    }
    match /child_emergency_reports/{id} {
      // Sensitive: owner (guardian) and moderators only. Public sees sanitized copy in /reports.
      allow read: if isOwner(resource.data.ownerId) || isMod();
      allow write: if false;
    }
    match /found_items/{id} {
      allow read: if resource.data.status == 'published' || isOwner(resource.data.ownerId) || isStaff();
      allow write: if false;
    }
    match /sightings/{id} {
      allow read: if isOwner(resource.data.reportOwnerId) || isMod();
      allow write: if false;
    }
    match /possible_matches/{id} {
      allow read: if isOwner(resource.data.missingOwnerId) || isOwner(resource.data.foundOwnerId) || isMod();
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','language']);
      allow create, delete: if false;
    }
    match /user_preferences/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['radiusKm','notifyMissing','notifyFound','notifyChild','notifyMatches'])
        && request.resource.data.radiusKm in [5,10,25,50];
    }
    match /saved_reports/{uid}/items/{rid} { allow read, write: if isOwner(uid); }
    match /blocked_users/{uid}/items/{bid} { allow read, write: if isOwner(uid); }
    match /notifications/{id} { allow read: if isOwner(resource.data.userId); allow write: if false; }
    match /complaints/{id} { allow read: if isOwner(resource.data.reporterId) || isStaff(); allow write: if false; }
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /geographical_locations/{id} { allow read: if true; allow write: if false; }
    match /administrators/{id} { allow read, write: if false; }
    match /audit_logs/{id} { allow read: if role() == 'super_admin'; allow write: if false; }
    match /moderation_actions/{id} { allow read: if isMod(); allow write: if false; }
    match /account_deletion_requests/{id} { allow read: if isOwner(resource.data.userId) || role()=='super_admin'; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
